# 复制为 .env 并按本机实际填写;.env 已被 .gitignore 排除(真实主机名不进公开 fork)
# RP_ID = 最终 HTTPS 主机名(不含端口);改动会使已注册 passkey 失效
RP_ID=gym-host.example-tailnet.ts.net
# ORIGIN = 完整 origin(含非标准端口,不带尾斜杠)
ORIGIN=https://gym-host.example-tailnet.ts.net:18445
# web 容器的宿主绑定(保持回环;对外由 tailscale serve 18445 提供)
WEB_PORT=127.0.0.1:18880
DEFAULT_LANG=zh
# 首个注册用户成为管理员;建完管理员后应关闭(置 0)并开启邀请限制
FIRST_USER_ADMIN=1
# AI Coach 提案预算 ms(配合 bridge 的 GYM_UPSTREAM_TIMEOUT_S=预算-10s)
COACH_JOB_TIMEOUT_MS=480000
